# 이 파일을 secrets.toml로 복사한 뒤 실제 키 값을 채워넣으세요.
# 로컬: .streamlit/secrets.toml (이 폴더, git에는 안 올라감)
# Streamlit Community Cloud 배포: 앱 설정 > Secrets 에 아래와 동일한 내용을 붙여넣으면 됩니다.

# FRED(연준 경제데이터) API 키 — https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료 발급
FRED_API_KEY = "your-fred-api-key-here"

# KRX 공공데이터포털 API 인증키 — https://data.krx.co.kr 에서 무료 발급
FG_KRX_AUTH_KEY = "your-krx-auth-key-here"
